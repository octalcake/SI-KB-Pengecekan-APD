  "narrative": {
    "northStar": "The Site Briefing",
    "overview": "A restrained professional interface for officers working through inspections and evidence. Deep petrol navigation anchors cool white work surfaces. Hierarchy comes from alignment, space, and readable typography rather than decoration.",
    "keyCharacteristics": [
      "Persistent, familiar navigation.",
      "Compact controls and explicit actions.",
      "Plain Indonesian task language.",
      "Evidence and provenance remain visible."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "Reserve cobalt for actions, links, focus, and selection; do not use it to decorate inactive content.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Touch-screen form inputs use at least 16px text; compact metadata must retain readable contrast.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do lead with the officer's task and its next action.",
      "Do preserve evidence, provenance, error recovery, and protected states.",
      "Do use native forms, disclosures, and familiar navigation.",
      "Do check desktop, narrow portrait, and touch landscape layouts."
    ],
    "donts": [
      "Don't put implementation instructions in routine task copy.",
      "Don't invent inspection statistics or imply safety from missing data.",
      "Don't use decorative gradients, module eyebrows, or icon tiles as page structure."
    ]
  }
