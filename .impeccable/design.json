      "kind": "button",
      "refersTo": "button-primary",
      "description": "The primary task action.",
      "html": "<button class=\"ds-primary\">Mulai inspeksi</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:40px;padding:.55rem .95rem;border-radius:6px;font-family:'Public Sans','Segoe UI',sans-serif;font-size:.875rem;font-weight:600;cursor:pointer;transition:background-color 150ms;background:var(--accent-primary);color:#fff;border:1px solid var(--accent-primary)}.ds-primary:hover{background:var(--accent-hover)}.ds-primary:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;}.ds-primary:active{background:var(--accent-hover)}.ds-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A secondary action or recovery step.",
      "html": "<button class=\"ds-secondary\">Coba lagi</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:40px;padding:.55rem .95rem;border-radius:6px;font-family:'Public Sans','Segoe UI',sans-serif;font-size:.875rem;font-weight:600;cursor:pointer;transition:background-color 150ms;background:var(--bg-surface);color:var(--ink-primary);border:1px solid var(--border-strong)}.ds-secondary:hover{background:var(--bg-subtle)}.ds-secondary:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "description": "Low-emphasis refresh or reset action.",
      "html": "<button class=\"ds-quiet\">Reset filter</button>",
      "css": ".ds-quiet{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:40px;padding:.55rem .95rem;border-radius:6px;font-family:'Public Sans','Segoe UI',sans-serif;font-size:.875rem;font-weight:600;cursor:pointer;transition:background-color 150ms;background:transparent;color:var(--ink-secondary);border:1px solid transparent}.ds-quiet:hover{background:var(--bg-subtle)}.ds-quiet:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;}"
    },
    {
      "name": "Labeled input",
      "kind": "input",
      "refersTo": "input",
      "description": "Standard labeled text entry.",
      "html": "<label class=\"ds-field\">Nama proyek<input placeholder=\"Masukkan nama proyek\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:.35rem;font-family:Public Sans,Segoe UI,sans-serif;font-size:.8rem;color:var(--ink-secondary)}.ds-field input{box-sizing:border-box;width:100%;min-height:40px;padding:.5rem .7rem;border:1px solid var(--border-strong);border-radius:6px;background:var(--bg-surface);color:var(--ink-primary);font:inherit;font-size:.875rem}.ds-field input::placeholder{color:var(--ink-muted)}.ds-field input:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;}.ds-field input:disabled{background:var(--bg-subtle)}"
