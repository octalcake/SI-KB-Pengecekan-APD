AI_MODE=real
MODEL_PATH=./models/best.pt
MODEL_MANIFEST_PATH=./models/model_manifest.json
DEVICE=cpu
IMGSZ=640
PREDICT_CONF_FLOOR=0.10
PERSON_CONF=0.35
VIOLATION_CONF=0.50
TRACKER_CONFIG=./config/bytetrack-k3.yaml
MAX_IMAGE_BYTES=1048576
MAX_IMAGE_PIXELS=1000000
